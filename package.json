{
  "name": "hackathon",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "@cloudflare/workers-types": "^5.20260728.1",
      "hono": "^4.12.32",
      "@trpc/server": "^11.18.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@trpc/client": "^11.18.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F @hackathon/infra --",
    "db:generate": "turbo run db:generate -F @hackathon/db --",
    "deploy": "turbo run deploy -F @hackathon/infra --",
    "destroy": "turbo run destroy -F @hackathon/infra --",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@hackathon/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@hackathon/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "^7.10.7"
  },
  "packageManager": "bun@1.2.20"
}
